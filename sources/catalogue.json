    {
      "id": "inventaire",
      "groupe": "poste",
      "etape": 1,
      "titre": "Inventaire du poste",
      "fichier": "Inventaire-Poste.ps1",
      "admin": false,
      "cible": "Ancien poste, session de l’utilisateur",
      "description": "Photographie complète de l’environnement : fond d’écran, icônes, barre des tâches, imprimantes, lecteurs, navigateurs, Outlook, logiciels. Génère la fiche de préparation et le script de copie des données.",
      "questions": [
        "Support du dossier de migration : clé ou disque USB, disque local, réseau (espace et FAT32 vérifiés)"
      ],
      "prerequis": "Lancer dans la session de l’utilisateur à migrer, sans élévation.",
      "source": "poste/Inventaire-Poste.ps1",
      "assemblage": "poste"
    },
    {
      "id": "restaure",
      "groupe": "poste",
      "etape": 3,
      "titre": "Restauration du poste",
      "fichier": "Restaure-Poste.ps1",
      "admin": false,
      "cible": "Nouveau poste, session de l’utilisateur",
      "description": "Recopie les données, remet l’environnement en place puis compare ancien et nouveau poste : écarts, corrections en un clic, check-list à valider avec l’utilisateur.",
      "questions": [
        "Dossier d’inventaire : recherché sur tous les lecteurs, clé USB comprise"
      ],
      "prerequis": "Première session ouverte, écrans réglés, logiciels installés, Office et navigateurs lancés une fois puis fermés.",
      "source": "poste/Restaure-Poste.ps1",
      "assemblage": "poste",
      "libelle": "Restaurer et contrôler",
      "arguments": [
        "-Restaurer"
      ]
    },
